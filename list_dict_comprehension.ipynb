   "source": [
    "# print the sq of 1 to 10 normal way\n",
    "\n",
    "for i in range(2,11):\n",
    "    print(f\"square of {i} is {i**2}\")\n",
    "sq = []\n",
    "\n",
    "for i in range(2,11):\n",
    "    sq.append(i**2)\n",
    "print(sq)\n",
    "\n",
    "squeare = [i**2 for i in range(2,11)]\n",
    "print(squeare)\n",
    "\n",
    "dict_sq = {sq:sq**2 for sq in range(2,11)}\n",
    "dict_sq\n",
    "\n",
    "\n"
   ]
